# .env.example
# ==============================================================================
# fastapi-blueprint - Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NEVER commit .env to git. It is in .gitignore.
# ==============================================================================

# -- Application ---------------------------------------------------------------
ENVIRONMENT=development             # development | staging | production
DEBUG=true                          # Enable debug mode (exposes tracebacks in errors)
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/v1

# -- Database ------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/boilerplate
DB_SCHEMA=app
DB_ECHO=false                       # Echo SQL queries to log (noisy, dev only)
DB_POOL_SIZE=10                     # Connection pool size

# -- Authentication ------------------------------------------------------------
REQUIRE_AUTH=false                  # Set true in staging/production
OAUTH_ALGORITHMS=["RS256"]          # NEVER use HS256 or none - algorithm confusion attack
OAUTH_TENANT_ID=                    # Azure AD tenant ID
OAUTH_JWKS_URL=                     # JWKS endpoint (auto-derived from tenant if empty)
INITIAL_ADMIN_EMAILS=               # Bootstrap admins: "alice@company.com,bob@company.com"

# -- CORS ----------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# -- Azure OpenAI --------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=              # https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=               # Your API key (use secrets manager in prod)
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_DEPLOYMENT=gpt-4o      # Deployment name for chat completions
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# -- Feature Flags -------------------------------------------------------------
BACKGROUND_JOBS_ENABLED=false       # Enable SQS-based background job processing
RAG_ENABLED=false                   # Enable RAG document ingestion and search
RATE_LIMITING_ENABLED=false         # Enable per-session and per-user rate limits

# -- Rate Limiting -------------------------------------------------------------
RATE_LIMIT_PER_SESSION=500          # Max LLM calls per session
RATE_LIMIT_PER_USER_HOURLY=100      # Max LLM calls per user per hour

# -- Broker (Message Queue) ----------------------------------------------------
DEFAULT_BROKER=sqs                  # sqs (add more implementations as needed)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566 # LocalStack for local dev
